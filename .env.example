# --- x402-canton-time configuration ---

# Facilitator that runs /verify and /settle (live on Canton MainNet).
FACILITATOR_URL=https://facilitator.ftptech.xyz

# Network (CAIP-2).
NETWORK=canton:mainnet

# Listen port.
PORT=3402

# Price per call, in atomic CC units (1 CC = 10^10). 100000000 = 0.01 CC.
X402_AMOUNT=100000000

# --- Canton MainNet party ids ---

# YOUR merchant party — receives the payment. This party must hold a live
# TransferPreapproval so transfer-factory settles in one tx:
#   npx @ftptech/canton-agent-wallet preapproval
CANTON_X402_PAYTO=your-merchant::1220...

# Facilitator party — relays the payment and sponsors the Global Synchronizer
# traffic fee (extra.feePayer). It must be the party the facilitator relays as,
# listed under "signers" in its /supported:
#   curl -s https://facilitator.ftptech.xyz/supported | jq '.signers'
CANTON_X402_FACILITATOR=ftp-x402-infrastructure::1220da867ceb28e1531ebfbea9ca9b25f75be06755999f48f0ec4b96f4174e3cd133

# The next two are network-wide public constants; the values below are Canton MainNet.

# Global Synchronizer id (extra.synchronizerId).
CANTON_SYNCHRONIZER_ID=global-domain::1220b1431ef217342db44d516bb9befde802be7d8899637d290895fa58880f19accc

# Instrument admin / DSO party (extra.instrumentId.admin; asset = <DSO>::Amulet).
CANTON_X402_DSO=DSO::1220b1431ef217342db44d516bb9befde802be7d8899637d290895fa58880f19accc

# Payment validity window in seconds (extra.executeBeforeSeconds).
EXECUTE_BEFORE_SECONDS=120
